# ============================================================
# lean (coolsnowwolf/lede) x86_64 配置
# 目标：x86/64 软路由 / 中文界面 / OpenVPN + OpenVPN Server / 输出 VMDK
#
# 用法：
#   cd ~/lede
#   cp 本文件 .config
#   make defconfig        # 在默认配置基础上补齐依赖、剔除无效符号，必须跑一次
#   make -j$(nproc) V=s   # 编译（首次建议 make -j1 V=s）
#
# 产物：bin/targets/x86/64/openwrt-x86-64-generic-ext4-combined.vmdk
#
# 说明：若某行符号在你这份源码里不存在，make defconfig 会自动丢弃，不影响编译。
# ============================================================

## ---------- 目标机型：x86_64 通用（lean lede 默认即 x86，这里锁定 64 位）----------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"

## ---------- 镜像格式：ext4 + squashfs + VMDK（含 GRUB 与 EFI）----------
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_TIMEOUT="3"
CONFIG_EFI_IMAGES=y
CONFIG_VMDK_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y

## ---------- LuCI 基础 + 中文界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-firewall-zh_Hans=y
CONFIG_PACKAGE_luci-i18n-opkg-zh_Hans=y

## ---------- OpenVPN + OpenVPN Server ----------
# openvpn-openssl：VPN 二进制（openssl 变体，server 依赖它）
# openvpn-easy-rsa：证书管理
# luci-app-openvpn：标准 Luci 应用（客户端/基础服务端界面）
# luci-app-openvpn-server：一键服务端 Luci 应用（lean luci feed 自带，依赖自动拉 kmod-tun）
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_openvpn-easy-rsa=y
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_luci-i18n-openvpn-zh_Hans=y
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-i18n-openvpn-server-zh_Hans=y
CONFIG_PACKAGE_kmod-tun=y

## ---------- 精简：不生成 SDK / ImageBuilder / 工具链 / 内核调试符号 ----------
# CONFIG_SDK is not set
# CONFIG_IB is not set
# CONFIG_MAKE_TOOLCHAIN is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_BUILD_PATENTED is not set
